JWT_SECRET=change-me-to-a-long-random-string

# Contraseña del rol de Postgres SIN privilegios de superusuario que usan
# la API y el worker para conectarse (ver db/init.sql.template). Es
# obligatoria -- si no la definís, el contenedor de Postgres no arranca.
# Generá una propia con: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
APP_DB_PASSWORD=CAMBIAME-por-una-contraseña-larga-y-random

# Usuario admin inicial: se crea/actualiza automáticamente al arrancar
# la API. Podés cambiar la contraseña después desde el dashboard
# (el usuario queda marcado con "debe cambiar contraseña" en el primer login).
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=ChangeMe123!

# Control de concurrencia / consumo de ancho de banda. El paralelismo
# total aproximado de escaneos activos (naabu/nmap/nuclei corriendo a la
# vez) es CELERY_CONCURRENCY x MAX_CONCURRENT_TARGETS. Con los defaults
# (2x2=4) ya es bastante agresivo para un link chico; bajalos a 1x1 si
# notás que un escaneo se come todo el ancho de banda disponible.
CELERY_CONCURRENCY=2
MAX_CONCURRENT_TARGETS=2

# Evasión de WAF/firewall (opcional, valores por defecto razonables).
# Se aplican los valores "_WAF" automáticamente cuando wafw00f detecta un
# WAF/CDN delante de un servicio HTTP; el resto del tiempo se usan los
# valores normales. Ver README para más detalle.
# NMAP_TIMING=T3
# NMAP_TIMING_WAF=T2
# NMAP_USE_DECOYS=false
# NAABU_RATE=1000
# NAABU_RATE_WAF=150
# NUCLEI_RATE_LIMIT=150
# NUCLEI_RATE_LIMIT_WAF=20
# NUCLEI_RETRIES=1
# NUCLEI_RETRIES_WAF=3
# RANDOM_USER_AGENT=true
# WAF_DETECTION_ENABLED=true
