JWT_SECRET=change-me-to-a-long-random-string

# Usuario admin inicial: se crea/actualiza automáticamente al arrancar
# la API. Podés cambiar la contraseña después desde el dashboard
# (el usuario queda marcado con "debe cambiar contraseña" en el primer login).
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=ChangeMe123!

# Evasión de WAF/firewall (opcional, valores por defecto razonables).
# Se aplican los valores "_WAF" automáticamente cuando wafw00f detecta un
# WAF/CDN delante de un servicio HTTP; el resto del tiempo se usan los
# valores normales. Ver README para más detalle.
# NMAP_TIMING=T3
# NMAP_TIMING_WAF=T2
# NMAP_USE_DECOYS=false
# NAABU_RATE=1000
# NAABU_RATE_WAF=150
# NUCLEI_RATE_LIMIT=150
# NUCLEI_RATE_LIMIT_WAF=20
# NUCLEI_RETRIES=1
# NUCLEI_RETRIES_WAF=3
# RANDOM_USER_AGENT=true
# WAF_DETECTION_ENABLED=true
